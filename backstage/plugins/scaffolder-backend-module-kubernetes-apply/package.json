{
  "name": "scaffolder-backend-module-kubernetes-apply",
  "description": "Backstage scaffolder module that applies a Kubernetes manifest via server-side apply (kubectl-apply semantics), for this repo's Backstage -> Crossplane golden path.",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "license": "MIT",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.0",
    "@backstage/plugin-scaffolder-node": "^0.13.6",
    "@kubernetes/client-node": "^2.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.6",
    "@backstage/cli": "^0.36.5",
    "@backstage/plugin-scaffolder-node-test-utils": "^0.3.14"
  },
  "files": [
    "dist"
  ]
}
